#usda 1.0
(
    defaultPrim = "BlackCube1cm"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "BlackCube1cm"
{
    def Cube "Cube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Materials/BlackMaterial>
        double size = 0.01
        color3f[] primvars:displayColor = [(0.005, 0.005, 0.005)]
    }
}

def Scope "Materials"
{
    def Material "BlackMaterial"
    {
        token outputs:surface.connect = </Materials/BlackMaterial/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.005, 0.005, 0.005)
            float inputs:roughness = 0.65
            float inputs:metallic = 0
            token outputs:surface
        }
    }
}
